# =============================================================================
# Kasir Koperasi Picha - Environment Variables Example
# Salin berkas ini ke .env untuk penyesuaian lokal jika diperlukan.
# =============================================================================

# Server Port (Default: 8000)
PORT=8000

# Mode Aplikasi (development / production)
NODE_ENV=production

# Konfigurasi Domain yang Diizinkan (Vercel & Cloudflare Tunnel)
ALLOWED_HOSTS=localhost,127.0.0.1,*.vercel.app,*.trycloudflare.com

# URL Database Eksternal (Opsional jika ingin sinkronisasi cloud: PostgreSQL/Supabase/Neon)
DATABASE_URL=

